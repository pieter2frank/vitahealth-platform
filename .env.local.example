# Supabase — vind dit in je Supabase project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# E-mail afzender
FROM_EMAIL=noreply@helpdesk.vita-health.nl

# App URL's
NEXT_PUBLIC_APP_URL=https://platform.vita-health.nl
NEXT_PUBLIC_PORTAL_URL=https://ikwilgraageentest.vita-health.nl

# Audit log: salt voor het hashen van IP-adressen en sessie-IDs
# Genereer een willekeurige string, bijv.: openssl rand -hex 32
AUDIT_HASH_SALT=vervang-met-willekeurige-string

# Cron-beveiliging: geheime sleutel voor /api/cron/audit-checks
# Genereer via: openssl rand -hex 32
CRON_SECRET=vervang-met-willekeurige-string

# Better Stack log drain (optioneel maar aanbevolen voor tamper-resistance)
# Aanmaken op: betterstack.com → Logs → Create source → HTTP → Source token
BETTERSTACK_SOURCE_TOKEN=

# ── PostNL Shipping/Labelling API ────────────────────────────────────────────
# Sandbox: https://api-sandbox.postnl.nl   |   Productie: https://api.postnl.nl
POSTNL_BASE_URL=https://api-sandbox.postnl.nl
POSTNL_API_KEY=
POSTNL_CUSTOMER_CODE=
POSTNL_CUSTOMER_NUMBER=
POSTNL_COLLECTION_LOCATION=
# Productcode brievenbuspakje met Track & Trace (controleer met je PostNL-contract)
POSTNL_PRODUCT_CODE=2928
POSTNL_WEIGHT_GRAMS=100
POSTNL_BARCODE_TYPE=3S
POSTNL_BARCODE_SERIE=000000000-999999999
# Afzender (verschijnt op het label)
POSTNL_SENDER_COMPANY=Vita Health
POSTNL_SENDER_STREET=
POSTNL_SENDER_HOUSENR=
POSTNL_SENDER_ZIPCODE=
POSTNL_SENDER_CITY=
POSTNL_SENDER_COUNTRY=NL
